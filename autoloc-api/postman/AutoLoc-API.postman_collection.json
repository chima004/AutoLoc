{
  "info": {
    "name": "AutoLoc-API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "Liste",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON array', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{asiApiUrl}}/agences"
          }
        },
        {
          "name": "Consultation-existant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.environment.get('asiApiUrl');",
                  "pm.sendRequest({",
                  "  url: url + '/agences',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ nom: 'Agence Postman', ville: 'Tunis', adresse: 'Centre ville' }) }",
                  "}, function (err, res) {",
                  "  pm.collectionVariables.set('agenceId', res.json().idAgence);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Agence has id', function () { pm.expect(pm.response.json().idAgence).to.eql(Number(pm.collectionVariables.get('agenceId'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{asiApiUrl}}/agences/{{agenceId}}"
          }
        },
        {
          "name": "Consultation-inexistant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error body', function () { pm.expect(pm.response.json().status).to.eql(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{asiApiUrl}}/agences/999999"
          }
        },
        {
          "name": "Ajout-sans-id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Id generated', function () { pm.expect(pm.response.json().idAgence).to.not.be.undefined; });",
                  "pm.collectionVariables.set('agenceId', pm.response.json().idAgence);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Sousse\",\n  \"ville\": \"Sousse\",\n  \"adresse\": \"Boulevard 14 Janvier\"\n}"
            },
            "url": "{{asiApiUrl}}/agences"
          }
        },
        {
          "name": "Ajout-avec-id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idAgence\": 1,\n  \"nom\": \"Agence Invalide\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Centre ville\"\n}"
            },
            "url": "{{asiApiUrl}}/agences"
          }
        },
        {
          "name": "Modification-existant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Nom updated', function () { pm.expect(pm.response.json().nom).to.eql('Agence Modifiée'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Modifiée\",\n  \"ville\": \"Sfax\",\n  \"adresse\": \"Route de Tunis\"\n}"
            },
            "url": "{{asiApiUrl}}/agences/{{agenceId}}"
          }
        },
        {
          "name": "Modification-inexistant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Fantôme\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Inconnue\"\n}"
            },
            "url": "{{asiApiUrl}}/agences/999999"
          }
        },
        {
          "name": "Suppression-existant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{asiApiUrl}}/agences/{{agenceId}}"
          }
        },
        {
          "name": "Suppression-inexistant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{asiApiUrl}}/agences/999999"
          }
        }
      ]
    },
